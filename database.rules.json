{
  "rules": {
    "sessions": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["room"],
      "$sessionId": {
        ".write": "auth != null && !data.exists() && (!root.child('leaderboard').child($sessionId).child('uid').exists() || root.child('leaderboard').child($sessionId).child('uid').val() === auth.uid) && (!root.child('rankings').child($sessionId).child('uid').exists() || root.child('rankings').child($sessionId).child('uid').val() === auth.uid)",
        ".validate": "$sessionId.matches(/^session_[0-9]{10,14}_[a-z0-9]{1,12}$/) && newData.hasChildren(['uid', 'createdAt', 'contentVersion', 'appVersion', 'locale', 'feedbackMode'])",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "createdAt": { ".validate": "newData.val() === now" },
        "contentVersion": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1"
        },
        "appVersion": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Za-z.+-]{1,32}$/)"
        },
        "locale": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$/)"
        },
        "feedbackMode": { ".validate": "newData.val() === 'each' || newData.val() === 'end'" },
        "room": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9][A-Z0-9-]{1,19}$/)"
        },
        "$other": { ".validate": false }
      }
    },
    "ratings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$studyId": {
        ".validate": "$studyId.matches(/^STUDY-[1-9][0-9]?$/)",
        "$sessionId": {
          ".write": "auth != null && !data.exists() && root.child('sessions').child($sessionId).child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['rating', 'prediction', 'timestamp', 'uid'])",
          "rating": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
          },
          "prediction": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
          },
          "responseTime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "timestamp": { ".validate": "newData.val() === now" },
          "uid": { ".validate": "newData.val() === auth.uid" },
          "contentVersion": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1"
          },
          "feedbackShown": { ".validate": "newData.isBoolean()" },
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100"
          },
          "trial": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 48"
          },
          "locale": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$/)"
          },
          "room": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9][A-Z0-9-]{1,19}$/)"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["room"],
      "$sessionId": {
        ".write": "auth != null && newData.exists() && root.child('sessions').child($sessionId).child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['score', 'papersRated', 'timestamp', 'uid', 'userName'])",
        "score": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= newData.parent().child('papersRated').val() * 100 && (data.exists() ? newData.val() >= data.val() && newData.val() <= data.val() + 100 : newData.val() <= 100)"
        },
        "papersRated": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 48 && (data.exists() ? newData.val() >= data.val() && newData.val() <= data.val() + 1 : newData.val() <= 1)"
        },
        "timestamp": { ".validate": "newData.val() === now" },
        "uid": { ".validate": "newData.val() === auth.uid" },
        "userName": {
          ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^(Red|Blue|Green|Yellow|Purple|Orange|Pink|Teal|Brave|Wise|Swift|Tall|Happy|Clever|Bright|Quick|Mighty|Gentle|Bold|Cheerful|Curious|Friendly|Kind|Peaceful) (Fox|Raccoon|Owl|Sparrow|Robin|Falcon|Eagle|Hawk|Rabbit|Squirrel|Deer|Bear|Wolf|Otter|Badger|Hedgehog|Dolphin|Seal|Penguin|Panda|Koala|Tiger|Lion|Leopard) [0-9]{2}(-[0-9]{1,3})?$/)"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9][A-Z0-9-]{1,19}$/)"
        },
        "$other": { ".validate": false }
      }
    },
    "rankings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["room"],
      "$sessionId": {
        ".write": "auth != null && !data.exists() && root.child('sessions').child($sessionId).child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['title', 'access', 'source', 'theory', 'methods', 'conclusion', 'userName', 'timestamp', 'uid']) && newData.child('title').val() + newData.child('access').val() + newData.child('source').val() + newData.child('theory').val() + newData.child('methods').val() + newData.child('conclusion').val() === 20",
        "title": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20"
        },
        "access": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20"
        },
        "source": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20"
        },
        "theory": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20"
        },
        "methods": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20"
        },
        "conclusion": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^(Red|Blue|Green|Yellow|Purple|Orange|Pink|Teal|Brave|Wise|Swift|Tall|Happy|Clever|Bright|Quick|Mighty|Gentle|Bold|Cheerful|Curious|Friendly|Kind|Peaceful) (Fox|Raccoon|Owl|Sparrow|Robin|Falcon|Eagle|Hawk|Rabbit|Squirrel|Deer|Bear|Wolf|Otter|Badger|Hedgehog|Dolphin|Seal|Penguin|Panda|Koala|Tiger|Lion|Leopard) [0-9]{2}(-[0-9]{1,3})?$/)"
        },
        "timestamp": { ".validate": "newData.val() === now" },
        "uid": { ".validate": "newData.val() === auth.uid" },
        "room": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9][A-Z0-9-]{1,19}$/)"
        },
        "$other": { ".validate": false }
      }
    },
    "active": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$sessionId": {
        ".write": "auth != null && root.child('sessions').child($sessionId).child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['joinedAt', 'lastActive', 'uid'])",
        "joinedAt": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },
        "lastActive": { ".validate": "newData.val() === now" },
        "uid": { ".validate": "newData.val() === auth.uid" },
        "room": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9][A-Z0-9-]{1,19}$/)"
        },
        "$other": { ".validate": false }
      }
    },
    "control": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "sessionsEndedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
      "$other": { ".validate": false }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "$other": { ".validate": false }
  }
}
