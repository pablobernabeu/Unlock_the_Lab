{
  "name": "unlock-the-lab",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive science-literacy workshop in which participants rate fictional studies and predict the crowd's ratings",
  "type": "module",
  "author": "Pablo Bernabeu (https://pablobernabeu.github.io)",
  "license": "MIT",
  "homepage": "https://unlock-the-lab.web.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/pablobernabeu/Unlock_the_Lab.git"
  },
  "bugs": "https://github.com/pablobernabeu/Unlock_the_Lab/issues",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only database,auth --project demo-unlock-the-lab \"vitest run --config vitest.rules.config.js\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only database,auth --project demo-unlock-the-lab",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "firebase": "^13.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "node-html-parser": "^9.0.5",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
