# vite build --mode test (end-to-end tests): local Firebase emulators only
VITE_USE_EMULATORS=true
# A demo- project id keeps the emulators offline and credential-free. The database
# namespace still comes from the production databaseURL (unlock-the-lab-workshop-default-rtdb),
# which is the instance that firebase.json gives the rules to.
VITE_FIREBASE_PROJECT_ID=demo-unlock-the-lab
